---
import { Font } from "astro:assets";
import { Icon } from 'astro-icon/components'
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import Activity from "../components/Activity.astro";
import Donation from "../components/Donation.astro";
import Contact from "../components/Contact.astro";
import Partners from "../components/Partners.astro";
---

<html class='lang="it"'>
  <head>
    <meta charset="utf-8" />
    <meta name="description" content="Promuoviamo la crescita di giovani e famiglie attraverso servizi socio-educativi, e creando legami di comunità per far sì che ogni persona sia valorizzata" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="icon" type="image/png" href="favicon-96x96.png" sizes="96x96" />
    <link rel="shortcut icon" href="favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/split-type@0.3.4/umd/index.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/lenis@1.1.14/dist/lenis.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/lenis@1.1.14/dist/lenis.css" />
    <script is:inline src="https://unpkg.com/@botpoison/browser" async></script>
    <script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0 " />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content="Michael Gauci">
    <Font cssVariable="--font-cabin-condensed" />
    <Font cssVariable="--font-urbanist" />
    <Font cssVariable="--font-poppins" />
    <title>Associazione Giovanni Paolo II</title>
  </head>
  <body class="scroll-smooth bg-primary text-secondary">
    <div id="smooth-wrapper">
      <div id="smooth-content">
        <Hero />
        <nav class="fixed z-50 top-0 w-full h-fit border-b border-gray-400 bg-primary">
          <div class="hidden md:flex justify-between">
            <div class="flex">
              <a href="/" class="flex items-center px-12 border-r border-gray-400" onclick="lenis.scrollTo('#home', { duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">
                <Icon name="logo" class="text-4xl"/>
              </a>
              <a href="/chi-siamo">
                <div class="box-btn">Chi siamo</div>
              </a>
              <a href="#cosa-facciamo" onclick="lenis.scrollTo('#cosa-facciamo', { duration: 1.5, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">
                <div class="box-btn">Cosa facciamo</div>
              </a>
              <a href="/notizie">
                <div class="box-btn">Notizie</div>
              </a>
              <a href="#contattaci" onclick="lenis.scrollTo('#contattaci', { duration: 1.5, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">
                <div class="box-btn border-r">Contattaci</div>
              </a>
            </div>
            <a href="#sostienici" onclick="lenis.scrollTo('#sostienici', { duration: 1.5, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">
              <div class="box-btn border-l">Sostienici</div>
            </a>
          </div>
          <div class="flex md:hidden justify-between items-center px-6 py-3">
            <a href="#home" onclick="lenis.scrollTo('#home', { duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">
              <Icon name="logo" class="text-4xl"/>
            </a>
            <button id="hamburger-btn" aria-label="Apri menu" aria-expanded="false">
              <span id="icon-hamburger">
                <Icon name="hamburger" class="text-4xl"/>
              </span>
              <span id="icon-close" class="hidden">
                <Icon name="close" class="text-4xl"/>
              </span>
            </button>
          </div>
        </nav>
        <div id="mobile-menu" class="fixed inset-0 z-40 flex flex-col bg-primary/95 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 ease-in-out" aria-hidden="true">
          <nav class="flex flex-col items-center justify-center flex-1 gap-12 tracking-widest text-sm font-semibold uppercase">
            <a href="/chi-siamo" onclick="closeMobileMenu()" >Chi siamo</a>
            <a href="#cosa-facciamo" onclick="closeMobileMenu(); lenis.scrollTo('#cosa-facciamo', { duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">Cosa facciamo</a>
            <a href="/notizie" onclick="closeMobileMenu()" >Notizie</a>
            <a href="#contattaci" onclick="closeMobileMenu(); lenis.scrollTo('#contattaci', { duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">Contattaci</a>
            <a href="#sostienici" onclick="closeMobileMenu(); lenis.scrollTo('#sostienici', { duration: 1.2, easing: (t) => 1 - Math.pow(1 - t, 4), offset: -document.querySelector('nav').offsetHeight })">Sostienici</a>
          </nav>
        </div>
        <Activity />
        <Donation />
        <Contact />
        <Partners />
        <Footer />
      </div>
    </div>
    <script type="text/javascript" src="/scripts/SmoothScrolling.js"></script>
    <script type="text/javascript" src="/scripts/LeafletMap.js"></script>
    <script type="text/javascript" src="/scripts/HamburgerMenu.js"></script>
    <script type="text/javascript" src="/scripts/ActivityReveal.js"></script>
    <script type="text/javascript" src="/scripts/RedirectOffset.js"></script>
  </body>
</html>
