---
import PolicyLayout from "../layouts/ArticleLayout.astro";
import { Content, frontmatter } from "../privacy.md";
import type { PolicyFrontmatter } from "../types";
import defaultImage from "../assets/default.png";

const formatDate = (dateString: string) => {
  const date = new Date(dateString);
  return {
    raw: date,
    formatted: date.toLocaleDateString("it-IT", {
      day: "numeric",
      month: "long",
      year: "numeric"
    })
  };
};

const enhancedFrontmatter = {
  ...frontmatter,
  date: formatDate(frontmatter.date),
  image: defaultImage,
};
---

<PolicyLayout frontmatter={enhancedFrontmatter as PolicyFrontmatter}>
  <Content />
</PolicyLayout>
