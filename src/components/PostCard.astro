---
import { Image } from 'astro:assets';
const { post } = Astro.props;
const { title, date, image } = post.data;
---

<a href={`/notizie/${post.id}`} class="flex flex-col gap-3 group" aria-label={`Leggi: ${title}`}>
  <div class="overflow-hidden aspect-4/3 bg-gray-100">
    {image
      ? <Image src={image} alt={title ?? ""} class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"/>
      : <div class="w-full h-full bg-gray-200"/>
    }
  </div>
  <div class="flex flex-col gap-1">
    <span class="font-heading text-h3/tight">{title}</span>
    {date && <span class="font-body text-h5 text-gray-500">{date.formatted}</span>}
  </div>
</a>
