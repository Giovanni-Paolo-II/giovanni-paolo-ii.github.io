---
import { Image } from 'astro:assets';
---

<section>
  <div class="mx-6 md:mx-8">
    <div class="flex flex-col py-8 md:py-12">
      <h1 class="font-heading text-h1/tight mb-20">Grazie ai nostri partner</h1>
      <div class="logos group relative overflow-hidden whitespace-nowrap py-6 md:py-10 mask-[linear-gradient(to_right,transparent_0,white_64px,white_calc(100%-64px),transparent_100%)] md:mask-[linear-gradient(to_right,transparent_0,white_128px,white_calc(100%-128px),transparent_100%)]">
        <div class="animate-slide-left inline-block w-max">
          <Image src={import("../assets/partners/AIRONE.png")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/il giglio.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/ARCOBALENO.png")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/anac.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/FONDAZIONE FRIULI.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/Regione FRIULI VENEZIA GIULIA.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/Comune di FIUME VENETO.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/Comune di PORCIA.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/Comune di PORDENONE.svg")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
          <Image src={import("../assets/partners/Tavolo di Comunità.png")} class="mx-6 md:mx-12 inline h-8 md:h-16 w-auto" alt="" />
        </div>
        <div class="animate-slide-left inline-block w-max">
